<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.porssiohjain-wind" path="/org/gnome/shell/extensions/porssiohjain-wind/">
    <key name="server-url" type="s">
      <default>'https://app.porssiohjain.fi'</default>
      <summary>Pörssiohjain server URL</summary>
    </key>
    <key name="timezone" type="s">
      <default>'Europe/Helsinki'</default>
      <summary>IANA timezone for forecast days</summary>
    </key>
    <key name="refresh-minutes" type="i">
      <default>15</default>
      <range min="1" max="60"/>
      <summary>Forecast refresh interval in minutes</summary>
    </key>
    <key name="show-unit" type="b">
      <default>true</default>
      <summary>Show MW in the top bar</summary>
    </key>
  </schema>
</schemalist>
